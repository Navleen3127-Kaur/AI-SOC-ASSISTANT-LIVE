<!-- Example -->
<group name="local,syslog,sshd,">

  <!--
  Dec 10 01:02:02 host sshd[1234]: Failed none for root from 1.1.1.1 port 1066 ssh2
  -->
  <rule id="100001" level="5">
    <if_sid>5716</if_sid>
    <srcip>1.1.1.1</srcip>
    <description>sshd: authentication failed from IP 1.1.1.1.</description>
    <group>authentication_failed,pci_dss_10.2.4,pci_dss_10.2.5,</group>
  </rule>

  <rule id="100050" level="7">
    <if_sid>184665,61603</if_sid>
    <field name="sysmon.image" type="pcre2">(?i)AppData.+?Local.+?Temp.+?\.exe</field>
    <description>Executable process launched from user Temp directory: $(sysmon.image)</description>
  </rule>

  <rule id="100051" level="7">
    <if_sid>184665,61603</if_sid>
    <field name="win.eventdata.image" type="pcre2">(?i)AppData.+?Local.+?Temp.+?\.exe</field>
    <description>Executable process launched from user Temp directory: $(win.eventdata.image)</description>
  </rule>

  <rule id="100052" level="0">
    <if_sid>92213</if_sid>
    <field name="win.eventdata.image" type="pcre2">(?i)powershell\.exe</field>
    <field name="win.eventdata.targetFilename" type="pcre2">(?i)__PSScriptPolicyTest_.+?\.ps1$</field>
    <description>Ignore benign PowerShell script execution policy checks</description>
  </rule>

</group>
